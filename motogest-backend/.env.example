# ============================================================
# MotoGest — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env no git
# ============================================================

# Servidor
NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/motogest

# JWT
JWT_SECRET=troque_por_uma_chave_muito_longa_e_aleatoria_aqui_min64chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Upload de fotos (opcional — Cloudinary ou local)
UPLOAD_PROVIDER=local        # local | cloudinary
CLOUDINARY_URL=              # se usar cloudinary
UPLOADS_DIR=./uploads

# CORS — domínios permitidos (separados por vírgula)
CORS_ORIGINS=http://localhost:3000,https://meusite.com.br

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutos
RATE_LIMIT_MAX=200           # requisições por janela

# Bcrypt
BCRYPT_ROUNDS=12

# Logs
LOG_LEVEL=debug              # error | warn | info | debug
